                },
                "phone_number": {
                    "type": "string",
                    "example": "+6281234567890"
                },
                "phone_verified": {
                    "type": "boolean",
                    "example": false
                },
                "username": {
                    "type": "string",
                    "example": "noctisnyx"
                }
